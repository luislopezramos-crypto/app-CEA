# Copia este archivo como .env y rellena los valores.

# Clave de OpenRouter (https://openrouter.ai/keys). Sin clave, el asistente usa respuestas de ejemplo.
OPENROUTER_API_KEY=

# Cualquier texto largo y aleatorio: firma las sesiones del panel.
SESSION_SECRET=

PORT=3000

# Acceso de demo al panel (se crea con `npm run seed`). Usuarios: recepcion (Sandra Patricia López Ramos) y francisco (Francisco Adrián López Ramos). Cámbialos antes de compartir la app.
DEMO_USER=recepcion
DEMO_PASSWORD=cea-demo-2026

# Conexión con la base de datos de Supabase (usuario propio de la app, por el pooler en modo sesión).
# Formato: postgresql://clinica_app.<id-del-proyecto>:<contraseña>@<servidor-del-pooler>:5432/postgres
# Los pasos para conseguirla están en el README («Prepara tu base de datos en Supabase»).
DATABASE_URL=
